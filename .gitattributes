# Store and check out text files with LF on every platform, regardless of core.autocrlf.
* text=auto eol=lf
*.png binary

# Keep development-only files out of the Composer distribution archive.
/docs               export-ignore
/tests              export-ignore
/.claude            export-ignore
/.gitattributes     export-ignore
/.gitignore         export-ignore
/phpunit.xml.dist   export-ignore
/.github            export-ignore
